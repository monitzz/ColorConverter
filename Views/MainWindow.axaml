<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ColorConverter.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="ColorConverter.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="ColorConverter">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel.Styles>
            <Style Selector="Grid Rectangle">
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style Selector="StackPanel">
                <Setter Property="Orientation" Value="Horizontal" />
            </Style>
        </StackPanel.Styles>
        <Grid RowDefinitions="50, 50"
              ColumnDefinitions="40, 15, 50, 50, 50"
              HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.Styles>
                <Style Selector="TextBox">
                    <Setter Property="Height" Value="30"/>
                    <Setter Property="Margin" Value="13 0"/>
                    <Setter Property="TextAlignment" Value="Center" />
                </Style>
                <Style Selector="TextBlock">
                    <Setter Property="HorizontalAlignment" Value="Center" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
                <Style Selector="StackPanel">
                    <Setter Property="Margin" Value="24, 0, 0, 0" />
                </Style>
            </Grid.Styles>
            <TextBlock Grid.Column="0" Grid.Row="0" Margin="0, 0, 5, 0" Text="RGB"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBox Name="RgbRedText" Grid.Column="2" Grid.Row="0"
                     Text="{Binding RText, Mode=TwoWay}" />
            <TextBox Name="RgbGreenText" Grid.Column="3" Grid.Row="0"
                     Text="{Binding GText, Mode=TwoWay}" />
            <TextBox Name="RgbBlueText" Grid.Column="4" Grid.Row="0"
                     Text="{Binding BText, Mode=TwoWay}" />
            <TextBlock Margin="0, 0, 5, 0" Text="Hex" Grid.Column="0" Grid.Row="1"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Text="#" Grid.Column="1" Grid.Row="1"
                       HorizontalAlignment="Right" Foreground="#8c8c8c" />
            <TextBox Name="HexText" Grid.Column="2" Grid.Row="1" Width="70"
                     Margin="6, 0, 0, 0" Text="{Binding HexadecimalText, Mode=TwoWay}" />
        </Grid>
        <Rectangle Name="ColorPreview" Height="150" Width="150" Margin="30, 0, 0, 0" />
    </StackPanel>
</Window>
